-->
<profiles xmlns:launcher="http://schemas.android.com/apk/res-auto">

    <grid-option
        launcher:name="3_by_3"
        launcher:numRows="3"
        launcher:numColumns="3"
        launcher:numAllAppsColumns="3"
        launcher:numFolderRows="2"
        launcher:numFolderColumns="3"
        launcher:numHotseatIcons="3"
        launcher:dbFile="launcher_3_by_3.db"
        launcher:defaultLayoutId="@xml/default_workspace_3x3"
        launcher:deviceCategory="phone|multi_display">

        <display-option
            launcher:name="Cat S22 Flip Compact 3x3"
            launcher:minWidthDps="200"
            launcher:minHeightDps="250"
            launcher:iconImageSize="48"
            launcher:iconTextSize="12.0"
            launcher:allAppsIconSize="46"
            launcher:allAppsIconTextSize="12.0"
            launcher:canBeDefault="true" />

    </grid-option>

    <grid-option
        launcher:name="4_by_5"
        launcher:numRows="5"
        launcher:numColumns="4"
        launcher:numAllAppsColumns="4"
        launcher:numFolderRows="3"
        launcher:numFolderColumns="3"
        launcher:numHotseatIcons="4"
        launcher:dbFile="launcher_4_by_5.db"
        launcher:defaultLayoutId="@xml/default_workspace_4x5"
        launcher:deviceCategory="phone|multi_display">

        <display-option
            launcher:name="Cat S22 Flip 4x5"
            launcher:minWidthDps="250"
            launcher:minHeightDps="350"
            launcher:iconImageSize="44"
            launcher:iconTextSize="11.0"
            launcher:allAppsIconSize="42"
            launcher:allAppsIconTextSize="11.0"
            launcher:canBeDefault="false" />

    </grid-option>

</profiles>
